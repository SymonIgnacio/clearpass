{
  "name": "barangay-management-server",
  "version": "1.0.1",
  "description": "Backend API for Barangay Management System",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "dev": "nodemon index.js",
    "test": "jest --coverage --watchAll=false --testTimeout=60000",
    "test:legacy": "jest __tests__/exhaustive-complete.test.js __tests__/certificates.test.js --watchAll=false",
    "test:integration": "jest --testMatch \"**/tests/integration/current/*.test.js\" --watchAll=false",
    "test:integration:legacy": "jest --runTestsByPath tests/integration/api.test.js --watchAll=false",
    "test:watch": "jest --watch",
    "lint": "eslint . --ext .js",
    "lint:fix": "eslint . --ext .js --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint:fix:format": "npm run lint:fix && npm run format",
    "security-audit": "npm audit --audit-level high",
    "security-check": "snyk test || echo 'Snyk not configured'",
    "db:audit": "node ../scripts/database/audit_schema.js",
    "db:migrate": "node ../scripts/database/migrate.cjs",
    "db:verify-schema-usage": "node ../scripts/database/verify_schema_usage.cjs",
    "validate-env": "node ../scripts/validate-env.cjs",
    "setup-env": "node ../scripts/validate-env.cjs generate"
  },
  "keywords": [
    "barangay",
    "management",
    "api",
    "security"
  ],
  "author": "Barangay Management Team",
  "license": "MIT",
  "dependencies": {
    "axios": "^1.13.2",
    "bcryptjs": "^2.4.3",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "docxtemplater": "^3.67.6",
    "dotenv": "^16.3.0",
    "exceljs": "^4.4.0",
    "express": "^4.18.2",
    "express-rate-limit": "^7.5.1",
    "express-validator": "^7.3.1",
    "fast-csv": "^5.0.5",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.0",
    "knex": "^3.1.0",
    "multer": "^1.4.5-lts.1",
    "mysql2": "^3.6.0",
    "nodemailer": "^8.0.10",
    "pdf-lib": "^1.17.1",
    "pdfkit": "^0.17.2",
    "pizzip": "^3.2.0",
    "prom-client": "^15.1.0",
    "qrcode": "^1.5.4",
    "redis": "^5.10.0",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.0",
    "validator": "^13.11.0",
    "winston": "^3.19.0",
    "winston-daily-rotate-file": "^5.0.0",
    "ws": "^8.16.0",
    "xss": "^1.0.15",
    "xss-clean": "^0.1.4"
  },
  "devDependencies": {
    "@eslint/js": "^8.56.0",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.3",
    "globals": "^13.24.0",
    "jest": "^29.7.0",
    "nodemon": "^3.0.0",
    "prettier": "^3.2.5",
    "puppeteer": "^24.33.1",
    "snyk": "^1.1291.1",
    "supertest": "^6.3.3"
  },
  "overrides": {
    "exceljs": {
      "uuid": "11.1.1"
    }
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "eslintConfig": {
    "env": {
      "browser": true,
      "commonjs": true,
      "es2021": true,
      "node": true,
      "jest": true
    },
    "extends": [
      "eslint:recommended",
      "plugin:prettier/recommended"
    ],
    "parserOptions": {
      "ecmaVersion": "latest",
      "sourceType": "module"
    },
    "rules": {
      "prettier/prettier": "error",
      "indent": [
        "error",
        2
      ],
      "linebreak-style": [
        "error",
        "unix"
      ],
      "quotes": [
        "error",
        "single"
      ],
      "semi": [
        "error",
        "always"
      ],
      "no-unused-vars": [
        "warn"
      ],
      "no-console": [
        "warn"
      ],
      "security/detect-object-injection": "error",
      "security/detect-non-literal-regexp": "error"
    }
  }
}
