# Database Configuration
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_NAME=barangay_management
DB_PORT=3306

# Server Configuration
SERVER_PORT=3002
CLIENT_URL=http://localhost:5173
AI_SERVICE_URL=http://localhost:5000

# JWT Configuration (Generate a secure random string)
JWT_SECRET=your_jwt_secret_key_here

# Authentication Configuration
ENABLE_MYSQL_AUTH_STAFF=true

# CORS Configuration (optional)
CORS_ORIGIN=http://localhost:5174

# Certificate Signatory Configuration
CERTIFICATE_SIGNATORY_CAPTAIN=Captain [Name]
CERTIFICATE_SIGNATORY_SECRETARY=Secretary [Name]
CERTIFICATE_LOCATION=Barangay [Name], [Municipality], [Province]